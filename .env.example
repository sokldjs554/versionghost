# Default demo requires no external credentials.
VERSIONGHOST_STATE_DIR=.versionghost

# Local/open-source model route (Ollama or another OpenAI-compatible server)
VERSIONGHOST_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
VERSIONGHOST_OPENAI_MODEL=qwen2.5-coder:7b
VERSIONGHOST_OPENAI_API_KEY=ollama
VERSIONGHOST_LLM_TIMEOUT_SECONDS=60

# Optional hosted model route
ANTHROPIC_API_KEY=
VERSIONGHOST_ANTHROPIC_MODEL=claude-sonnet-4-5
